# Frontend build-time configuration (Vite).
# Copy to `.env` for local development. Only VITE_* vars reach the browser —
# never put the admin password or any secret in this file.

# Base URL of the FourFold API (the Lambda Function URL).
# Printed by `npx ampx sandbox` / the Amplify build, e.g.
# https://abc123def456.lambda-url.eu-west-2.on.aws
VITE_API_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-side configuration. These are NOT set here in production — they live
# in SSM Parameter Store (see README "Secrets and configuration"). They are
# only used by `npm run sync:local` and the local API for development.
# ---------------------------------------------------------------------------

# AWS_REGION=eu-west-2
# FOURFOLD_TABLE_NAME=fourfold
# FOURFOLD_ADMIN_PASSWORD_HASH=   # scrypt hash, generate with scripts/hash-password.ts
# FOURFOLD_TOKEN_SECRET=          # random 32+ byte hex, signs admin session tokens
